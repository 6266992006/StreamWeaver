# Copy this file to .env and fill in the values.   cp .env.example .env

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/streamweaver
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Where the React app is served. Used for the link in the password-reset email.
FRONTEND_URL=http://localhost:5173

# Comma-separated emails that become ADMINS (can see everyone's imports).
# Everyone else is an analyst. Change it, then sign in again.
ADMIN_EMAILS=

# Optional — real emails (password reset, "import finished"). Leave empty and the
# backend prints the email, including the reset link, in its terminal instead.
# For Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional rate-limit tuning (requests per 15 minutes per IP)
# RATE_LIMIT_MAX=1000
# AUTH_RATE_LIMIT_MAX=10
